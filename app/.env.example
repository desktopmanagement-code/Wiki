# Kopiere diese Datei nach ".env" und trage deinen OpenAI-Schlüssel ein.
OPENAI_API_KEY=sk-...

# Modelle (bei Bedarf ändern)
OPENAI_MODEL=gpt-5.5
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Port der App im Browser
PORT=3000

# Für das Handy im WLAN: HTTPS einschalten (Mikrofon funktioniert im Browser nur über https)
HTTPS=false

# Passwort für die App (empfohlen, sobald du sie im WLAN öffnest). Leer = kein Passwort.
APP_PASSWORT=

# Nach jeder Notiz automatisch zu GitHub hochladen
GIT_AUTO_PUSH=true
GIT_BRANCH=Main
